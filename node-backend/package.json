{
  "name": "whatsapp-campaign-automation-backend",
  "version": "1.0.0",
  "description": "WhatsApp Campaign Automation Platform - Node.js Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint --ext .js src",
    "lint:fix": "eslint --ext .js src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify:redis": "node scripts/verify-redis.js",
    "verify:queue": "node scripts/verify-bull-queue.js"
  },
  "dependencies": {
    "axios": "1.6.8",
    "bcrypt": "5.1.1",
    "bull": "4.12.2",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "csv-parser": "3.0.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.2.0",
    "express-validator": "7.0.1",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.3.1",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdfkit": "0.14.0",
    "twilio": "5.0.4",
    "uuid": "9.0.1",
    "winston": "3.13.0",
    "winston-daily-rotate-file": "5.0.0",
    "xlsx": "0.18.5",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-node": "11.1.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "3.1.0",
    "prettier": "3.2.5",
    "supertest": "7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
