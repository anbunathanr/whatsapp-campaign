# ============================================================
# WhatsApp Campaign Automation Platform - Environment Config
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
# Application environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
# Full MongoDB connection URI. For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/whatsapp_campaign_platform

# Maximum number of connections in the Mongoose connection pool
MONGODB_POOL_SIZE=10

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# Full Redis connection URL (takes precedence over REDIS_HOST/REDIS_PORT below)
# For Redis Cloud or Upstash: redis://:password@host:port
REDIS_URL=redis://localhost:6379

# Alternative: individual host/port/password (used when REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis AUTH password — leave blank if your Redis instance has no password
REDIS_PASSWORD=

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# Secret used to sign access tokens — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Access token lifetime (e.g. 15m, 1h, 24h)
JWT_EXPIRES_IN=24h

# Secret used to sign refresh tokens — must differ from JWT_SECRET
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# Twilio WhatsApp API
# ------------------------------------------------------------
# Find these in your Twilio Console: https://console.twilio.com
# Account SID starts with "AC..."
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token — keep this secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The WhatsApp-enabled Twilio number in E.164 format prefixed with "whatsapp:"
# Sandbox default: whatsapp:+14155238886
# Production: whatsapp:+<your_approved_number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------
# Webhook Security
# ------------------------------------------------------------
# HMAC secret used to verify incoming Twilio webhook signatures
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your_webhook_hmac_secret_change_in_production

# ------------------------------------------------------------
# n8n Workflow Automation
# ------------------------------------------------------------
# Base URL of your n8n instance
N8N_BASE_URL=http://localhost:5678

# n8n API key — create one in n8n Settings → API
N8N_API_KEY=your_n8n_api_key_here

# ------------------------------------------------------------
# Python ML Classification Service
# ------------------------------------------------------------
# URL of the FastAPI industry-classifier microservice
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------
# Directory (relative to project root) where uploaded files are stored
UPLOAD_DIR=uploads

# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
# Time window for rate limiting in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per IP within the window
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where log files are written (relative to project root).
# NOTE: In production (AWS ECS), file logging is disabled — logs go to
# CloudWatch via stdout. This setting only applies in development.
LOG_DIR=logs

# ------------------------------------------------------------
# Public Application URL
# ------------------------------------------------------------
# The publicly reachable base URL of this backend server.
# Required for Twilio to download media attachments (MMS/WhatsApp media).
# In production, set this to your ALB or domain URL (no trailing slash):
#   https://api.yourdomain.com
# Without this, campaigns with media attachments will send text-only messages.
PUBLIC_APP_URL=http://localhost:5000

# ------------------------------------------------------------
# AWS S3 (Production File Storage)
# ------------------------------------------------------------
# In production on AWS ECS / Fargate, the container filesystem is ephemeral
# and uploaded files are lost on restart. Use S3 for persistent file storage.
#
# Set S3_BUCKET_NAME to your S3 bucket name and configure the ECS task role
# with s3:PutObject / s3:GetObject permissions on that bucket.
# The application currently uses local disk storage (uploads/media/).
# Migrate the mediaUpload middleware to use @aws-sdk/client-s3 before launch.
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

