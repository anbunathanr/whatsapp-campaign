# ============================================================
# WhatsApp Campaign Platform — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the value for your deployment.
# NEVER commit .env to version control.
#
# Vite embeds these values at BUILD TIME into the static bundle.
# You must rebuild the frontend any time you change this value.
#
# For AWS deployments:
#   - Pass VITE_API_URL as a Docker build argument:
#     docker build --build-arg VITE_API_URL=https://api.yourdomain.com/api .
#   - OR set it in AWS Amplify / CodeBuild environment variables before build.
# ============================================================

# Full URL to the backend API (including /api path).
# Local development: http://localhost:5000/api
# AWS production:    https://api.yourdomain.com/api  (your ALB or API Gateway URL)
VITE_API_URL=http://localhost:5000/api
